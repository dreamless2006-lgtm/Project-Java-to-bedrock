      "scripts": {
        "pre_animation": [
          "v.phase = q.property('minepreggo:phase');",
          "v.pose = q.property('minepreggo:pose');",
          "v.kick = q.property('minepreggo:kick');",
          "v.savage = q.property('minepreggo:savage');",
          "v.aggressive = q.has_target;",
          "v.kicking = v.pose == 'fetal_movement' || v.pose == 'kicking_sit' || v.pose == 'incapacitated';",
          "v.kick = v.pose == 'incapacitated' ? 1 : v.kick;",
          "v.belly_growth = (v.phase <= 2 ? 1.0 : (v.phase <= 4 ? 0.9 : (v.phase == 5 ? 0.8 : (v.phase <= 7 ? 0.7 : 0.6)))) * q.property('minepreggo:growth');",
          "v.fuse_ticks = v.phase <= 2 ? 30 : (v.phase <= 5 ? 38 : (v.phase <= 7 ? 46 : 62));",
          "v.swell_raw = q.fuse_time >= 0 ? math.clamp(v.fuse_ticks - q.fuse_time + q.frame_alpha - 1.0, 0.0, 30.0) / 28.0 : 0.0;",
          "v.swell = math.clamp(v.swell_raw, 0.0, 1.0);",
          "v.swell = v.swell * v.swell * v.swell * v.swell;",
          "v.wobble = 1.0 + math.sin(v.swell_raw * 5729.578) * v.swell_raw * 0.01;",
          "v.scale_xz = (0.9375 + v.swell * 0.399) * v.wobble;",
          "v.scale_y = (0.9375 + v.swell * 0.099) / v.wobble;",
          "v.flash = (v.swell_raw > 0.0 && math.mod(math.floor(q.life_time * 20.0), 6.0) != 0.0) ? math.clamp(v.swell_raw, 0.5, 1.0) * 0.75 : 0.0;"
        ],
        "scaleX": "v.scale_xz",
        "scaleY": "v.scale_y",
        "scaleZ": "v.scale_xz",
        "animate": [
          {
            "look_at_target": "!q.is_sitting && (v.pose == 'none' || v.pose == 'belly_rubs')"
          },
          "loop_controller",
          {
            "walk": "v.aggressive ? 0.0 : math.min(q.modified_move_speed * 4.0, 1.0)"
          },
          {
            "aggression": "v.aggressive ? math.min(q.modified_move_speed * 4.0, 1.0) : 0.0"
          },
          "attack_controller",
          "pain_controller",
          {
            "belly_low": "v.phase >= 0 && v.phase <= 2"
          },
          {
            "belly_medium": "v.phase >= 3 && v.phase <= 6 && !v.kicking"
          },
          {
            "belly_high": "v.phase >= 7 && !v.kicking"
          },
          {
            "belly_growth": "v.phase >= 0"
          },
          {
            "fetal_p3_i": "v.kicking && v.phase == 3 && v.kick == 0"
          },
