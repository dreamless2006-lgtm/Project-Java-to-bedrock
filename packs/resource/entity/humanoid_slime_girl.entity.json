        "p8": "geometry.minepreggo.humanoid_slime_girl_p8",
        "p9": "geometry.minepreggo.humanoid_slime_girl_p9"
      },
      "scripts": {
        "scale": "1.075",
        "scaleX": "1.0 + 0.4 * (1.0 / (v.squish / 1.5 + 1.0) - 1.0)",
        "scaleY": "v.squish / 1.5 + 1.0",
        "scaleZ": "1.0 + 0.4 * (1.0 / (v.squish / 1.5 + 1.0) - 1.0)",
        "initialize": [
          "v.was_on_ground = 1.0;",
          "v.squish = 0.0;",
          "v.squish_target = 0.0;"
        ],
        "pre_animation": [
          "v.phase = q.property('minepreggo:phase');",
          "v.pose = q.property('minepreggo:pose');",
          "v.kick = q.property('minepreggo:kick');",
          "v.savage = q.property('minepreggo:savage');",
          "v.aggressive = q.has_target;",
          "v.kicking = v.pose == 'fetal_movement' || v.pose == 'kicking_sit' || v.pose == 'incapacitated';",
          "v.kick = v.pose == 'incapacitated' ? 1 : v.kick;",
          "v.belly_growth = (v.phase <= 2 ? 1.0 : (v.phase <= 4 ? 0.9 : (v.phase == 5 ? 0.8 : (v.phase <= 7 ? 0.7 : 0.6)))) * q.property('minepreggo:growth');",
          "v.squish_target = (q.is_on_ground && !v.was_on_ground) ? -0.5 : ((!q.is_on_ground && v.was_on_ground) ? 1.0 : v.squish_target);",
          "v.was_on_ground = q.is_on_ground;",
          "v.squish = v.squish + (v.squish_target - v.squish) * (1.0 - math.pow(0.5, 20.0 * q.delta_time));",
          "v.squish_target = v.squish_target * math.pow(0.6, 20.0 * q.delta_time);"
        ],
        "animate": [
          {
            "look_at_target": "!q.is_sitting && (v.pose == 'none' || v.pose == 'belly_rubs')"
          },
          "loop_controller",
          {
            "walk": "v.aggressive ? 0.0 : math.min(q.modified_move_speed * 4.5, 1.0)"
          },
          {
            "aggression": "v.aggressive ? math.min(q.modified_move_speed * 4.5, 1.0) : 0.0"
          },
          "attack_controller",
          "pain_controller",
          "squish_controller",
          {
            "belly_low": "v.phase >= 0 && v.phase <= 2"
          },
          {
            "belly_medium": "v.phase >= 3 && v.phase <= 6 && !v.kicking"
          },
          {
            "belly_high": "v.phase >= 7 && !v.kicking"
          },
          {
            "belly_growth": "v.phase >= 0"
          },
          {
            "fetal_p3_i": "v.kicking && v.phase == 3 && v.kick == 0"
          },
          {
            "fetal_p3_ii": "v.kicking && v.phase == 3 && v.kick == 1"
          },
          {
            "fetal_p3_iii": "v.kicking && v.phase == 3 && v.kick == 2"
          },
          {
            "fetal_p4_i": "v.kicking && v.phase == 4 && v.kick == 0"
          },
          {
            "fetal_p4_ii": "v.kicking && v.phase == 4 && v.kick == 1"
          },
          {
            "fetal_p4_iii": "v.kicking && v.phase == 4 && v.kick == 2"
          },
          {
            "fetal_p5_i": "v.kicking && v.phase == 5 && v.kick == 0"
          },
          {
            "fetal_p5_ii": "v.kicking && v.phase == 5 && v.kick == 1"
          },
          {
            "fetal_p5_iii": "v.kicking && v.phase == 5 && v.kick == 2"
          },
          {
            "fetal_p6_i": "v.kicking && v.phase == 6 && v.kick == 0"
          },
          {
            "fetal_p6_ii": "v.kicking && v.phase == 6 && v.kick == 1"
          },
          {
            "fetal_p6_iii": "v.kicking && v.phase == 6 && v.kick == 2"
          },
          {
            "fetal_p7_i": "v.kicking && v.phase == 7 && v.kick == 0"
          },
          {
            "fetal_p7_ii": "v.kicking && v.phase == 7 && v.kick == 1"
          },
          {
            "fetal_p7_iii": "v.kicking && v.phase == 7 && v.kick == 2"
          },
          {
            "fetal_p8_i": "v.kicking && v.phase == 8 && v.kick == 0"
          },
          {
            "fetal_p8_ii": "v.kicking && v.phase == 8 && v.kick == 1"
          },
          {
            "fetal_p8_iii": "v.kicking && v.phase == 8 && v.kick == 2"
          },
          {
            "fetal_p9_i": "v.kicking && v.phase == 9 && v.kick == 0"
          },
          {
            "fetal_p9_ii": "v.kicking && v.phase == 9 && v.kick == 1"
          },
          {
            "fetal_p9_iii": "v.kicking && v.phase == 9 && v.kick == 2"
          }
        ]
      },
      "animations": {
