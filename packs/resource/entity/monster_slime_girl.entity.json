      "scripts": {
        "pre_animation": [
          "v.phase = q.property('minepreggo:phase');",
          "v.pose = q.property('minepreggo:pose');",
          "v.push = v.pose == 'birth' ? q.property('minepreggo:growth') : 0.0;",
          "v.kick = q.property('minepreggo:kick');",
          "v.savage = q.property('minepreggo:savage');",
          "v.aggressive = q.has_target;",
          "v.kicking = v.pose == 'fetal_movement' || v.pose == 'kicking_sit' || v.pose == 'incapacitated' || v.pose == 'prebirth' || v.pose == 'birth';",
          "v.kick = v.pose == 'incapacitated' ? 1 : v.kick;",
          "v.kl = 1.0 + v.kick;",
          "v.belly_growth = (v.phase <= 2 ? 1.0 : (v.phase <= 4 ? 0.9 : (v.phase == 5 ? 0.8 : (v.phase <= 7 ? 0.7 : 0.6)))) * q.property('minepreggo:growth');",
          "v.hostile_p3 = v.phase == 3 && !q.is_tamed;",
          "v.squish_age = (v.squish_age ?? 10.0) + q.delta_time;",
          "v.squish_x = v.squish_age * 10.0;",
          "v.squish = (v.squish_amp ?? 0.0) * v.squish_x * math.exp(1.0 - v.squish_x) / 1.5;",
          "v.squish_lateral = 1.0 + 0.4 * (1.0 / (v.squish + 1.0) - 1.0);",
          "v.jdt = math.clamp(q.delta_time, 0.0, 0.1);",
          "v.jf = v.jdt / 0.05;",
          "v.jvy = q.position_delta(1) / 0.05;",
          "v.jh = math.sqrt(math.pow(q.position_delta(0), 2) + math.pow(q.position_delta(2), 2));",
          "v.jvert = math.abs(v.jvy) > 0.05;",
          "v.jair = !q.is_on_ground || v.jvert;",
          "v.jk = v.phase <= 1 ? 2.5 : (v.phase <= 4 ? 3.0 : (v.phase <= 7 ? 3.5 : 4.0));",
          "v.jmd = v.phase <= 1 ? 0.4 : (v.phase <= 4 ? 0.35 : (v.phase <= 7 ? 0.25 : 0.2));",
          "v.jmm = v.phase <= 7 ? 0.7 : 0.6;",
          "v.jmrx = v.phase <= 1 ? 0.065 : 0.12;",
          "v.jmrz = v.phase <= 1 ? 0.065 : 0.18;",
          "(v.jair && !v.jwas_air) ? { v.jtx = math.random(-1.0, 1.0) * v.jmrx; v.jtz = math.random(-1.0, 1.0) * v.jmrz; v.jet = math.random(0.4, 0.8); };",
          "(!v.jair && v.jwas_air) ? { v.jet = 0.0; };",
          "v.jwas_air = v.jair;",
          "v.jmi = v.jh > 0.001 ? math.min(1.0, v.jmi + v.jh * v.jmm * v.jf) : v.jmi * math.pow(0.9, v.jf);",
          "(v.jmi > 0.01 || v.jvert) ? { v.jo = v.jo + 0.15 * math.max(v.jmi, math.abs(v.jvy) * 2.0) * v.jf; };",
          "v.jec = (v.jec + (v.jet - v.jec) * 0.15 * v.jf) * math.pow(0.85, v.jf);",
          "v.jpd = v.jo * 57.2958;",
          "v.jany = v.jmi > 0.05 || v.jvert;",
          "v.javy = math.abs(v.jvy);",
          "v.jvl = (v.jvl + (-v.jpl * v.jk - v.jvy * 0.1 - 0.02 * (v.jvl > 0 ? 1.0 : (v.jvl < 0 ? -1.0 : 0.0)) + v.jmi * 0.08 * math.sin((v.jpd + 0.0)) + 0.2 * math.cos(1.3 * (v.jpd + 0.0)) * v.jmi + 1.0 * 0.08 * math.sin(1.5 * (v.jpd + 0.0)) * v.jmi) * v.jf) * math.pow(0.4, v.jf);",
          "v.jpl = math.clamp(v.jpl + v.jvl * 0.05 * v.jf, -v.jmd, v.jmd);",
          "v.jty = v.jany ? (v.jmi * 0.25 * math.cos(0.8 * (v.jpd + 0.0)) + v.jvl * 0.4 + 1.0 * 0.2 * 1.5 * v.jmi * math.sin(1.1 * (v.jpd + 0.0)) + v.jvy * 0.3 + 1.0 * 0.05 * v.jmi) : 0.0;",
          "v.jryvl = (v.jryvl + (v.jty - v.jryl) * (v.jany ? 0.25 : 0.35) * v.jf) * math.pow(0.88, v.jf);",
          "v.jryl = math.clamp(v.jryl + v.jryvl * 0.05 * v.jf, -0.15, 0.15);",
          "v.jtx2 = v.jany ? ((v.jair && v.jvert) ? (v.jtx + math.sin(2.5 * (v.jpd + 0.0)) * v.javy * 0.15 + 1.0 * 0.08 * math.cos(2.0 * (v.jpd + 0.0)) * v.javy * 0.2) : (v.jmi * 0.2 * math.sin(1.2 * (v.jpd + 0.0)) + v.jvy * 0.25 + 1.0 * 0.2 * 0.8 * math.cos(0.95 * (v.jpd + 0.0)) + (v.jvert ? (math.sin(1.5 * (v.jpd + 0.0)) * v.javy * 0.4 + 1.0 * 0.08 * math.cos(1.8 * (v.jpd + 0.0)) * v.javy) : 0.0))) : 0.0;",
          "v.jrxvl = (v.jrxvl + (v.jtx2 - v.jrxl) * (v.jany ? 0.23 : 0.35) * v.jf) * math.pow(0.88, v.jf);",
          "v.jrxl = math.clamp(v.jrxl + v.jrxvl * 0.05 * v.jf, -v.jmrx, v.jmrx);",
          "v.jtz2 = v.jany ? ((v.jair && v.jvert) ? (v.jtz + 1.0 * math.cos(2.3 * (v.jpd + 0.0)) * v.javy * 0.18 + 1.0 * 0.08 * math.sin(2.2 * (v.jpd + 0.0)) * v.javy * 0.25) : (v.jmi * 0.22 * math.cos(1.05 * (v.jpd + 0.0)) + 1.0 * v.jvl * 0.6 + 1.0 * 0.2 * 1.5 * math.sin(1.15 * (v.jpd + 0.0)) + (v.jvert ? (1.0 * math.cos(1.3 * (v.jpd + 0.0)) * v.javy * 0.5 + 1.0 * 0.16 * math.sin(1.6 * (v.jpd + 0.0)) * v.javy) : 0.0))) : 0.0;",
          "v.jrzvl = (v.jrzvl + (v.jtz2 - v.jrzl) * (v.jany ? 0.27 : 0.35) * v.jf) * math.pow(0.88, v.jf);",
          "v.jrzl = math.clamp(v.jrzl + v.jrzvl * 0.05 * v.jf, -v.jmrz, v.jmrz);",
          "v.jvr = (v.jvr + (-v.jpr * v.jk - v.jvy * 0.1 - 0.02 * (v.jvr > 0 ? 1.0 : (v.jvr < 0 ? -1.0 : 0.0)) + v.jmi * 0.08 * math.sin((v.jpd + 180.0)) + 0.2 * math.cos(1.3 * (v.jpd + 180.0)) * v.jmi + -1.0 * 0.08 * math.sin(1.5 * (v.jpd + 180.0)) * v.jmi) * v.jf) * math.pow(0.4, v.jf);",
          "v.jpr = math.clamp(v.jpr + v.jvr * 0.05 * v.jf, -v.jmd, v.jmd);",
          "v.jty = v.jany ? (v.jmi * 0.25 * math.cos(0.8 * (v.jpd + 180.0)) + v.jvr * 0.4 + -1.0 * 0.2 * 1.5 * v.jmi * math.sin(1.1 * (v.jpd + 180.0)) + v.jvy * 0.3 + -1.0 * 0.05 * v.jmi) : 0.0;",
          "v.jryvr = (v.jryvr + (v.jty - v.jryr) * (v.jany ? 0.25 : 0.35) * v.jf) * math.pow(0.88, v.jf);",
          "v.jryr = math.clamp(v.jryr + v.jryvr * 0.05 * v.jf, -0.15, 0.15);",
          "v.jtx2 = v.jany ? ((v.jair && v.jvert) ? (v.jtx + math.sin(2.5 * (v.jpd + 180.0)) * v.javy * 0.15 + -1.0 * 0.08 * math.cos(2.0 * (v.jpd + 180.0)) * v.javy * 0.2) : (v.jmi * 0.2 * math.sin(1.2 * (v.jpd + 180.0)) + v.jvy * 0.25 + -1.0 * 0.2 * 0.8 * math.cos(0.95 * (v.jpd + 180.0)) + (v.jvert ? (math.sin(1.5 * (v.jpd + 180.0)) * v.javy * 0.4 + -1.0 * 0.08 * math.cos(1.8 * (v.jpd + 180.0)) * v.javy) : 0.0))) : 0.0;",
          "v.jrxvr = (v.jrxvr + (v.jtx2 - v.jrxr) * (v.jany ? 0.23 : 0.35) * v.jf) * math.pow(0.88, v.jf);",
          "v.jrxr = math.clamp(v.jrxr + v.jrxvr * 0.05 * v.jf, -v.jmrx, v.jmrx);",
          "v.jtz2 = v.jany ? ((v.jair && v.jvert) ? (v.jtz + -1.0 * math.cos(2.3 * (v.jpd + 180.0)) * v.javy * 0.18 + -1.0 * 0.08 * math.sin(2.2 * (v.jpd + 180.0)) * v.javy * 0.25) : (v.jmi * 0.22 * math.cos(1.05 * (v.jpd + 180.0)) + -1.0 * v.jvr * 0.6 + -1.0 * 0.2 * 1.5 * math.sin(1.15 * (v.jpd + 180.0)) + (v.jvert ? (-1.0 * math.cos(1.3 * (v.jpd + 180.0)) * v.javy * 0.5 + -1.0 * 0.16 * math.sin(1.6 * (v.jpd + 180.0)) * v.javy) : 0.0))) : 0.0;",
          "v.jrzvr = (v.jrzvr + (v.jtz2 - v.jrzr) * (v.jany ? 0.27 : 0.35) * v.jf) * math.pow(0.88, v.jf);",
          "v.jrzr = math.clamp(v.jrzr + v.jrzvr * 0.05 * v.jf, -v.jmrz, v.jmrz);",
          "v.jb_y = -((v.jpl - v.jec) + (v.jpr - v.jec)) * 0.5;",
          "v.jb_ry = (v.jryl + v.jryr) * 0.5 * 57.2958;",
          "v.jb_rx = (v.jrxl + v.jrxr) * 0.5 * 57.2958;",
          "v.jbl_y = -(v.jpl - v.jec) * 0.4;",
          "v.jbr_y = -(v.jpr - v.jec) * 0.4;",
          "v.jbl_ry = v.jryl * 0.5 * 57.2958;",
          "v.jbr_ry = v.jryr * 0.5 * 57.2958;",
          "v.jbl_rx = v.jrxl * 0.6 * 57.2958;",
          "v.jbr_rx = v.jrxr * 0.6 * 57.2958;",
          "v.jbl_rz = v.jrzl * 0.6 * 57.2958;",
          "v.jbr_rz = v.jrzr * 0.6 * 57.2958;",
          "v.jbmm = v.phase <= 1 ? 0.65 : (v.phase <= 7 ? 0.6 : 0.5);",
          "v.jbmr = v.phase <= 1 ? 0.125 : 0.6;",
          "v.jbmi = v.jh > 0.001 ? math.min(1.0, v.jbmi + v.jh * v.jbmm * v.jf) : v.jbmi * math.pow(0.92, v.jf);",
          "(v.jh > 0.001) ? { v.jbo = v.jbo + 0.45 * math.max(v.jbmi, v.javy * 2.0) * v.jf; };",
          "v.jbpd = v.jbo * 1.5 * 57.2958;",
          "v.jbv = (v.jbv + (-v.jbp * 0.15 - v.jvy * 0.1 - 0.02 * (v.jbv > 0 ? 1.0 : (v.jbv < 0 ? -1.0 : 0.0)) + v.jbmi * 0.05 * math.sin(v.jbpd)) * v.jf) * math.pow(0.85, v.jf);",
          "v.jbp = math.clamp(v.jbp + v.jbv * 0.05 * v.jf, -0.7, 0.7);",
          "v.jbrv = (v.jbrv + ((v.jbv * 0.5 + v.jbmi * 0.2 * math.cos(0.8 * v.jbpd)) - v.jbr) * 0.2 * v.jf) * math.pow(0.88, v.jf);",
          "v.jbr = math.clamp(v.jbr + v.jbrv * 0.05 * v.jf, -v.jbmr, v.jbmr);",
          "v.jbelly_y = v.phase >= 0 ? -v.jbp : 0.0;",
          "v.jbelly_ry = v.phase >= 0 ? v.jbr * 57.2958 : 0.0;",
          "v.jtv = (v.jtv + (-v.jtp * 0.15 - v.jvy * 0.1 - 0.02 * (v.jtv > 0 ? 1.0 : (v.jtv < 0 ? -1.0 : 0.0))) * v.jf) * math.pow(0.85, v.jf);",
          "v.jtp = math.clamp(v.jtp + v.jtv * 0.05 * v.jf, -1.0, 1.0);",
          "v.jbutt_y = v.phase >= 3 ? -v.jtp : 0.0;"
        ],
        "scaleX": "1.2 * v.squish_lateral",
        "scaleY": "1.2 * (1.0 + v.squish)",
        "scaleZ": "1.2 * v.squish_lateral",
        "animate": [
          {
            "look_at_target": "!q.is_sitting && (v.pose == 'none' || v.pose == 'belly_rubs')"
          },
          "hop_controller",
          {
