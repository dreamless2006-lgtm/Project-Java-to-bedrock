          },
          {
            "fetal_p6_iii": "v.kicking && v.phase == 6 && v.kick == 2"
          },
          {
            "fetal_p7_i": "v.kicking && v.phase == 7 && v.kick == 0"
          },
          {
            "fetal_p7_ii": "v.kicking && v.phase == 7 && v.kick == 1"
          },
          {
            "fetal_p7_iii": "v.kicking && v.phase == 7 && v.kick == 2"
          },
          {
            "fetal_p8_i": "v.kicking && v.phase == 8 && v.kick == 0"
          },
          {
            "fetal_p8_ii": "v.kicking && v.phase == 8 && v.kick == 1"
          },
          {
            "fetal_p8_iii": "v.kicking && v.phase == 8 && v.kick == 2"
          },
          {
