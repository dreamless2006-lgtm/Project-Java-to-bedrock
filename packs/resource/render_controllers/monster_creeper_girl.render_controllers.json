{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.minepreggo.monster_creeper_girl": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": "v.flash > 0.0 ? 1.0 : this",
        "g": "v.flash > 0.0 ? 1.0 : this",
        "b": "v.flash > 0.0 ? 1.0 : this",
        "a": "v.flash > 0.0 ? v.flash : this"
      }
    },
    "controller.render.minepreggo.monster_creeper_girl_charged": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.charged"
        }
      ],
      "textures": [
        "Texture.charged"
      ],
      "overlay_color": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "uv_anim": {
        "offset": [
          "(Math.floor(q.life_time * 20.0) + q.frame_alpha) * 0.01",
          "(Math.floor(q.life_time * 20.0) + q.frame_alpha) * 0.01"
        ],
        "scale": [
          1,
          1
        ]
      },
      "light_color_multiplier": 0.5,
      "ignore_lighting": true
    }
  }
}
