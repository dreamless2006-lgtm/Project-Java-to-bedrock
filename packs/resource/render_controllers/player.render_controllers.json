{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.minepreggo.player_skin": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.minepreggo_alex"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "helmet": "variable.helmet_layer_visible"
        },
        {
          "leftLegging": "variable.leg_layer_visible"
        },
        {
          "rightLegging": "variable.leg_layer_visible"
        },
        {
          "leftBoot": "variable.boot_layer_visible"
        },
        {
          "rightBoot": "variable.boot_layer_visible"
        },
        {
          "leftSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "rightSock": "variable.boot_layer_visible && variable.leg_layer_visible"
        },
        {
          "bodyArmor": "variable.chest_layer_visible"
        },
        {
          "leftArmArmor": "variable.chest_layer_visible"
        },
        {
          "rightArmArmor": "variable.chest_layer_visible"
        },
        {
          "belt": "variable.chest_layer_visible && variable.leg_layer_visible"
        }
      ]
    },
    "controller.render.minepreggo.player_boobs": {
      "geometry": "Geometry.minepreggo_boobs_custom",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.minepreggo.player_belly_custom": {
      "geometry": "Geometry.minepreggo_belly_custom",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.minepreggo.player_belly_predefined": {
      "geometry": "Geometry.minepreggo_belly_predefined",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.minepreggo_alex_extra_all"
      ]
    },
    "controller.render.minepreggo.player_labor": {
      "geometry": "Geometry.minepreggo_labor",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "variable.mp_predefined ? Texture.minepreggo_alex : Texture.default"
      ]
    },
    "controller.render.minepreggo.player_boobs_predefined": {
      "geometry": "Geometry.minepreggo_boobs_predefined",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.minepreggo_alex_extra"
      ]
    }
  }
}
