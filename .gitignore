# Dependencies and build output
node_modules/
dist/

# The original Forge jar lives here locally; it is All Rights Reserved, so it is never committed
vendor/

# Assets generated from the jar by `npm run import` (third-party art, sounds and text, see README)
packs/resource/textures/minepreggo/
packs/resource/sounds/minepreggo/
packs/resource/models/entity/minepreggo/
packs/resource/animations/minepreggo/
packs/resource/texts/*.lang
# The Jenny add-ons (vendor/jenny/, merged by tools/import-jenny.mjs): the Jenny Mod Java Port under
# jenny_port/ sub-folders plus its UI, and the older pack's house structure
packs/behavior/structures/
packs/behavior/**/jenny_port/
packs/resource/**/jenny_port/
packs/resource/jenny_port/
packs/resource/ui/
packs/resource/pack_icon.png
packs/behavior/pack_icon.png
# Expandable Goblins (vendor/goblins/, merged by tools/import-goblins.mjs)
packs/behavior/**/goblins_port/
packs/resource/**/goblins_port/
# Minecraft Comes Alive (vendor/mca/, merged by tools/import-mca.mjs)
packs/behavior/**/mca_port/
packs/resource/**/mca_port/
